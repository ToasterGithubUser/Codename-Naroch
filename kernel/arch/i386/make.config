KERNEL_ARCH_CFLAGS=
KERNEL_ARCH_CPPFLAGS=
KERNEL_ARCH_LDFLAGS=
KERNEL_ARCH_LIBS=

KERNEL_ARCH_OBJS=\
$(ARCHDIR)/boot.o \
$(ARCHDIR)/tty.o \
$(ARCHDIR)/gdt.o \
$(ARCHDIR)/idt.o \
$(ARCHDIR)/interrupt.o \
$(ARCHDIR)/keyboard.o \
$(ARCHDIR)/shell.o \
$(ARCHDIR)/conversions.o \
$(ARCHDIR)/timer.o \
$(ARCHDIR)/pmm.o \
$(ARCHDIR)/paging.o \
$(ARCHDIR)/heap.o \
$(ARCHDIR)/task.o \
$(ARCHDIR)/mutex.o \
$(ARCHDIR)/fat16.o \
$(patsubst %.o,%.o,$(wildcard $(ARCH_DIR)/*.o)) \
$(patsubst %.c,%.o,$(wildcard $(ARCH_DIR)/*.c)) \
$(patsubst %.S,%.o,$(wildcard $(ARCH_DIR)/*.S)) \
